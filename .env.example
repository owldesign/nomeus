APP_NAME=devkit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://devkit.test

LOG_CHANNEL=daily
LOG_LEVEL=debug

# No database in 1a. TaskRunner (1c) uses ~/.devkit/tasks; sessions and cache are files.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Overrides for tests / non-standard layouts. Leave unset to use ~/.devkit and ~/.config/valet.
# DEVKIT_CONFIG_PATH=
# DEVKIT_VALET_CONFIG_DIR=
# DEVKIT_SITE=devkit

VITE_APP_NAME="${APP_NAME}"
