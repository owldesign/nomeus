{
    "name": "nomeus/client",
    "description": "In-app hooks for nomeus: tags outgoing mail so Mailpit shows one inbox per app.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": { "Nomeus\\Client\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Nomeus\\Client\\NomeusClientServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
